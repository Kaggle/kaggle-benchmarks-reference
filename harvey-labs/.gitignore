# Harbor writes run output here (jobs_dir in config.yaml).
jobs/

# Ad-hoc run output from `harbor run -o results/`.
results/

.env
__pycache__/
*.pyc

# Kaggle dataset CLI file
dataset-metadata.json

# ...except the shared-corpus one. It is hand-written, is the only thing in the
# publish flow no generator can recreate, and is kept outside assets/ so the
# corpus staged there is byte-identical to the published dataset. It is copied
# into assets/ at publish time; see "Publishing the corpus" in README.md.
!assets-metadata/dataset-metadata.json

# Generated task directories -- 2.9 GB of already-compressed .docx/.xlsx that
# git cannot pack down, across 70,000 files. They are not committed; the Kaggle
# dataset build materializes them with
#
#   python3 scripts/port_tasks.py --upstream /path/to/harvey-labs --area all
#
# against upstream at the commit pinned in scripts/port_tasks.py:SOURCE_COMMIT.
# templates/ + scripts/ + config.yaml are the tracked source of truth; see the
# "Adding tasks" section of README.md.
tasks/

# Assets uploaded to jmasukawa/harvey-lab-task-shared-documents. These get mounted
# via asset mounts to avoid input duplication when tasks share the same documents.
assets/
assets-metadata/
